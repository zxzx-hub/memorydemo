MEMORY_APP_NAME=agent-memory-service
MEMORY_ENVIRONMENT=development
MEMORY_LOG_LEVEL=INFO
MEMORY_HOST=0.0.0.0
MEMORY_PORT=8000
MEMORY_DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory
MEMORY_REDIS_URL=redis://localhost:6379/0
MEMORY_READINESS_TIMEOUT_SECONDS=2
MEMORY_ENABLE_DEVELOPMENT_TENANT_RESOLVER=true
MEMORY_CONSOLIDATION_MESSAGE_COUNT=10
MEMORY_CONSOLIDATION_TOKEN_RATIO=0.7
MEMORY_CONSOLIDATION_IDLE_SECONDS=600
MEMORY_WORKING_MEMORY_TTL_SECONDS=86400
MEMORY_RETRIEVAL_SEMANTIC_WEIGHT=0.35
MEMORY_RETRIEVAL_CONFIDENCE_WEIGHT=0.15
MEMORY_RETRIEVAL_IMPORTANCE_WEIGHT=0.15
MEMORY_RETRIEVAL_EXPLICITNESS_WEIGHT=0.10
MEMORY_RETRIEVAL_FRESHNESS_WEIGHT=0.10
MEMORY_RETRIEVAL_USAGE_WEIGHT=0.05
MEMORY_RETRIEVAL_SCOPE_WEIGHT=0.10
MEMORY_RETRIEVAL_FRESHNESS_HALF_LIFE_DAYS=180
